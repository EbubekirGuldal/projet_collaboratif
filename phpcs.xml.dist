<?xml version="1.0"?>
<ruleset name="Ressources Relationnelles">
    <description>Conventions de codage PSR-12 appliquees a src/.</description>

    <file>src</file>

    <!-- Repertoires generes ou importes : hors perimetre. -->
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="colors"/>
    <arg name="basepath" value="."/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
</ruleset>
