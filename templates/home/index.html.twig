{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container py-4 py-lg-5 feed-page">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="feed-shell">
        <div class="feed-main">
            <section class="feed-hero card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <div class="feed-hero-row">
                        <div class="feed-hero-copy">
                            <span class="feed-eyebrow">Ressources relationnelles</span>
                            <h1 class="feed-title mb-2">Fil d’actualité</h1>
                            <p class="feed-subtitle mb-0">
                                Un espace clair pour trouver, partager et suivre les ressources utiles de la communauté.
                            </p>
                        </div>

                        <div class="feed-sort" role="group" aria-label="Tri du fil">
                            <a
                                class="feed-sort__btn {{ sort == 'new' ? 'is-active' : '' }}"
                                href="{{ path('app_home', {
                                    q: q,
                                    sort: 'new',
                                    resourceType: resourceTypeId,
                                    relationKind: relationKindId
                                }) }}"
                            >
                                <i class="fa-regular fa-clock"></i>
                                <span>Récent</span>
                            </a>
                            <a
                                class="feed-sort__btn {{ sort == 'top' ? 'is-active' : '' }}"
                                href="{{ path('app_home', {
                                    q: q,
                                    sort: 'top',
                                    resourceType: resourceTypeId,
                                    relationKind: relationKindId
                                }) }}"
                            >
                                <i class="fa-solid fa-arrow-trend-up"></i>
                                <span>Populaire</span>
                            </a>
                        </div>
                    </div>

                    <form method="get" action="{{ path('app_home') }}" class="row g-3 mt-3">
                        <input type="hidden" name="sort" value="{{ sort }}">

                        <div class="col-12 col-lg-4">
                            <label class="form-label fw-semibold">Recherche</label>
                            <input
                                type="text"
                                name="q"
                                value="{{ q }}"
                                class="form-control"
                                placeholder="Titre, contenu, lien..."
                            >
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label fw-semibold">Type de ressource</label>
                            <select name="resourceType" class="form-select">
                                <option value="">Tous les types</option>
                                {% for type in resourceTypes %}
                                    <option value="{{ type.id }}" {{ resourceTypeId == type.id ? 'selected' : '' }}>
                                        {{ type.label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-12 col-lg-3">
                            <label class="form-label fw-semibold">Public concerné</label>
                            <select name="relationKind" class="form-select">
                                <option value="">Tous les publics</option>
                                {% for public in relationKinds %}
                                    <option value="{{ public.id }}" {{ relationKindId == public.id ? 'selected' : '' }}>
                                        {{ public.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-12 col-lg-2 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary w-100">
                                Filtrer
                            </button>
                            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                                Reset
                            </a>
                        </div>
                    </form>

                    {% if q or resourceTypeId or relationKindId %}
                        <div class="feed-search-state mt-3">
                            <span class="feed-search-pill">
                                <i class="fa-solid fa-filter"></i>
                                Filtres actifs
                            </span>
                            <a class="feed-search-reset" href="{{ path('app_home') }}">Effacer</a>
                        </div>
                    {% endif %}
                </div>
            </section>

            <div class="feed-list mt-4">
                {% if feedItems is empty %}
                    <section class="card border-0 shadow-sm feed-empty-state">
                        <div class="card-body p-4 p-lg-5">
                            <div class="feed-empty-icon">
                                <i class="fa-regular fa-folder-open"></i>
                            </div>
                            <h2 class="h5 mt-3 mb-2">Aucune ressource à afficher</h2>
                            <p class="text-body-secondary mb-0">
                                Essaie un autre filtre ou reviens plus tard pour voir les prochaines publications.
                            </p>
                        </div>
                    </section>
                {% endif %}

                {% for item in feedItems %}
                    {% include 'resource/_card.html.twig' with {
                        resource: item.resource,
                        commentsCount: item.commentsCount,
                        isFavorite: app.user ? app.user.isFavorite(item.resource) : false
                    } only %}
                {% endfor %}
            </div>
        </div>

        <aside class="feed-sidebar">
            <div class="feed-sidebar__inner">
                <section class="card border-0 shadow-sm feed-side-card">
                    <div class="card-body p-4">
                        <div class="feed-side-head">
                            <span class="feed-side-icon">
                                <i class="fa-solid fa-circle-info"></i>
                            </span>
                            <div>
                                <h2 class="h6 mb-1">À propos</h2>
                                <p class="feed-side-subtitle mb-0">Le projet en bref</p>
                            </div>
                        </div>

                        <p class="feed-side-copy mb-0">
                            Ressources relationnelles rassemble des contenus utiles, des repères fiables et des pistes concrètes
                            pour renforcer les liens sociaux et l’entraide.
                        </p>
                    </div>
                </section>

                <section class="card border-0 shadow-sm feed-side-card">
                    <div class="card-body p-4">
                        <div class="feed-side-head">
                            <span class="feed-side-icon">
                                <i class="fa-solid fa-bolt"></i>
                            </span>
                            <div>
                                <h2 class="h6 mb-1">Actions rapides</h2>
                                <p class="feed-side-subtitle mb-0">Accès directs</p>
                            </div>
                        </div>

                        {% if app.user %}
                            <div class="d-grid gap-2 mt-3">
                                <a class="btn btn-dark" href="{{ path('resource_new') }}">
                                    <i class="fa-solid fa-plus me-2"></i>
                                    Proposer une ressource
                                </a>
                                <a class="btn btn-outline-dark" href="{{ path('app_profile') }}">
                                    <i class="fa-regular fa-user me-2"></i>
                                    Voir mon profil
                                </a>
                                <a class="btn btn-outline-dark" href="{{ path('app_profile_saved') }}">
                                    <i class="fa-regular fa-bookmark me-2"></i>
                                    Voir mes enregistrements
                                </a>
                            </div>
                            <p class="feed-side-note mb-0 mt-3">
                                Tu peux maintenant filtrer le fil par type de ressource et par public concerné.
                            </p>
                        {% else %}
                            <p class="feed-side-copy mt-3">
                                Connecte-toi pour commenter, sauvegarder et proposer des ressources.
                            </p>
                            <div class="d-grid gap-2">
                                <a class="btn btn-dark" href="{{ path('app_login') }}">Connexion</a>
                                <a class="btn btn-outline-dark" href="{{ path('app_register') }}">Inscription</a>
                            </div>
                        {% endif %}
                    </div>
                </section>
            </div>
        </aside>
    </div>
</div>
{% endblock %}