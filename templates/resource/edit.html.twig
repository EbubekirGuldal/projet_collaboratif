{% extends 'base.html.twig' %}

{% block title %}
    Modifier la ressource | {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container py-4 py-lg-5">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <section class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <a class="text-decoration-none small" href="{{ path('resource_show', { id: resource.id }) }}">
                                    &larr; Retour à la ressource
                                </a>
                                <h1 class="h3 mt-2 mb-1">Modifier ma ressource</h1>
                                <p class="text-body-secondary mb-0">
                                    Mets à jour le contenu et les informations de ciblage de ta ressource.
                                </p>
                            </div>

                            <a class="btn btn-outline-dark" href="{{ path('app_profile_created_resources') }}">
                                <i class="fa-regular fa-folder-open me-2"></i>
                                Mes ressources créées
                            </a>
                        </div>

                        {{ form_start(form) }}
                            <div class="row g-4">
                                <div class="col-12 col-lg-7">
                                    <div class="card border-0 bg-light-subtle h-100">
                                        <div class="card-body p-4">
                                            <h2 class="h6 mb-3">Contenu</h2>

                                            <div class="mb-3">
                                                {{ form_label(form.title) }}
                                                {{ form_widget(form.title) }}
                                                {{ form_errors(form.title) }}
                                            </div>

                                            <div class="mb-0">
                                                {{ form_label(form.content) }}
                                                {{ form_widget(form.content) }}
                                                {{ form_errors(form.content) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-5">
                                    <div class="card border-0 bg-light-subtle h-100">
                                        <div class="card-body p-4">
                                            <h2 class="h6 mb-3">Paramètres</h2>

                                            <div class="mb-3">
                                                {{ form_label(form.ressourceType) }}
                                                {{ form_widget(form.ressourceType) }}
                                                {{ form_errors(form.ressourceType) }}
                                            </div>

                                            <div class="mb-3">
                                                {{ form_label(form.relationKind) }}
                                                {{ form_widget(form.relationKind) }}
                                                {{ form_errors(form.relationKind) }}
                                            </div>

                                            <div class="mb-3">
                                                {{ form_label(form.externalUrl) }}
                                                {{ form_widget(form.externalUrl) }}
                                                {{ form_errors(form.externalUrl) }}
                                            </div>

                                            <div class="mb-3">
                                                {{ form_label(form.category) }}
                                                {{ form_widget(form.category) }}
                                                {{ form_errors(form.category) }}
                                            </div>

                                            <div class="mb-3">
                                                {{ form_label(form.video) }}
                                                {{ form_widget(form.video) }}
                                                {{ form_errors(form.video) }}
                                            </div>

                                            <div class="mb-0">
                                                {{ form_label(form.imageFile) }}
                                                {{ form_widget(form.imageFile) }}
                                                {{ form_errors(form.imageFile) }}

                                                {% if resource.image %}
                                                    <div class="mt-3">
                                                        <p class="small text-body-secondary mb-2">Illustration actuelle</p>
                                                        <img
                                                            src="/images/resources/{{ resource.image }}"
                                                            alt="Illustration actuelle de la ressource"
                                                            class="img-fluid rounded border"
                                                            loading="lazy"
                                                        >
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                                <a class="btn btn-outline-secondary" href="{{ path('resource_show', { id: resource.id }) }}">
                                    Annuler
                                </a>
                                <button type="submit" class="btn btn-dark">
                                    <i class="fa-regular fa-floppy-disk me-2"></i>
                                    Enregistrer les modifications
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}