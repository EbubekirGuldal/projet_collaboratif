{% set excerpt = resource.content|striptags %}
{% if excerpt|length > 220 %}
    {% set excerpt = excerpt|slice(0, 220) ~ '...' %}
{% endif %}

{% set publishedLabel = resource.publishedAt ?: resource.createdAt %}
{% set popularityScore = (resource.likesCount ?? 0) + (resource.sharesCount ?? 0) + commentsCount %}
{% set isPopular = popularityScore >= 8 %}
{% set isFavorited = isFavorite|default(false) %}

<article class="card feed-card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="feed-card__layout">
            <div class="feed-card__main">
                <header class="feed-card__header">
                    <div class="feed-card__meta">
                        {% if publishedLabel %}
                            <span class="feed-card__date">
                                <i class="fa-regular fa-calendar"></i>
                                {{ publishedLabel|date('d/m/Y H:i') }}
                            </span>
                        {% endif %}

                        {% if isPopular %}
                            <span class="feed-card__badge">
                                <i class="fa-solid fa-fire"></i>
                                Populaire
                            </span>
                        {% endif %}
                    </div>

                    <h2 class="feed-card__title mb-0">
                        <a class="feed-card__title-link" href="{{ path('resource_show', { id: resource.id }) }}">
                            {{ resource.title }}
                        </a>
                    </h2>
                </header>

                <div class="feed-card__body">
                    <p class="feed-card__excerpt mb-0">{{ excerpt }}</p>

                    {% if resource.externalUrl %}
                        <a
                            class="feed-card__external"
                            href="{{ resource.externalUrl }}"
                            target="_blank"
                            rel="noopener"
                        >
                            <i class="fa-solid fa-link"></i>
                            <span>Consulter la ressource</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    {% endif %}
                </div>

                <footer class="feed-card__footer">
                    <a
                        class="feed-action feed-action--link"
                        href="{{ path('resource_show', { id: resource.id }) }}"
                        title="Voir les commentaires"
                    >
                        <i class="fa-regular fa-comment"></i>
                        <span>{{ commentsCount }}</span>
                    </a>

                    <button
                        class="btn btn-sm feed-action btn-like {{ (resource.likesCount ?? 0) > 0 ? 'btn-primary' : 'btn-outline-primary' }}"
                        data-id="{{ resource.id }}"
                        title="Marquer comme utile"
                        type="button"
                    >
                        <i class="fa-regular fa-thumbs-up"></i>
                        <span class="like-count">{{ resource.likesCount ?? 0 }}</span>
                    </button>

                    <button
                        class="btn btn-sm feed-action feed-action--share btn-share btn-outline-secondary"
                        data-id="{{ resource.id }}"
                        data-url="{{ absolute_url(path('resource_show', { id: resource.id })) }}"
                        data-title="{{ resource.title|e('html_attr') }}"
                        title="Partager"
                        type="button"
                    >
                        <i class="fa-solid fa-share-nodes"></i>
                        <span>Partager</span>
                        <span class="share-count">{{ resource.sharesCount ?? 0 }}</span>
                    </button>

                    <button
                        class="btn btn-sm feed-action feed-action--bookmark btn-favorite {{ isFavorited ? 'btn-warning' : 'btn-outline-warning' }}"
                        data-id="{{ resource.id }}"
                        title="Sauvegarder"
                        aria-label="Sauvegarder"
                        type="button"
                    >
                        <i class="fa-regular fa-bookmark"></i>
                    </button>
                </footer>
            </div>

            {% if resource.image %}
                <a class="feed-thumb" href="{{ path('resource_show', { id: resource.id }) }}" aria-label="Voir la ressource {{ resource.title }}">
                    <img
                        src="/images/resources/{{ resource.image }}"
                        alt="Illustration de la ressource"
                        class="img-fluid"
                        loading="lazy"
                    >
                </a>
            {% endif %}
        </div>
    </div>
</article>