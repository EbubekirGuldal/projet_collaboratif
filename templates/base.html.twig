<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ressources Relationnelles{% endblock %}</title>

    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {% block stylesheets %}
        {# Si vous utilisez Webpack Encore #}
        {{ encore_entry_link_tags('app') }}
        <link rel="stylesheet" href="{{ asset('styles/bootstrap.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
    {% endblock %}
</head>

<body>
    {% include "includes/navbar.html.twig" %}

    {% block body %}{% endblock %}

    {% include "includes/footer.html.twig" %}
    {% block javascripts %}
        {# Si vous utilisez Webpack Encore #}
        {{ encore_entry_script_tags('app') }}
        {# Si vous utilisez Importmap (Symfony 7) #}
        {% block importmap %}{{ importmap('app') }}{% endblock %}

        {# Scripts interactions feed #}
        <script>
        document.addEventListener('click', function(e) {

            // ===== LIKE =====
            const likeBtn = e.target.closest('.btn-like');
            if (likeBtn) {
                const id = likeBtn.dataset.id;

                fetch(`/resource/${id}/like`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    if (!data || data.error) return;

                    const countEl = likeBtn.querySelector('.like-count');
                    if (countEl) countEl.innerText = data.likes;

                    if (data.liked) {
                        likeBtn.classList.remove('btn-outline-primary');
                        likeBtn.classList.add('btn-primary');
                    } else {
                        likeBtn.classList.remove('btn-primary');
                        likeBtn.classList.add('btn-outline-primary');
                    }

                    likeBtn.style.transform = "scale(1.1)";
                    setTimeout(() => likeBtn.style.transform = "scale(1)", 150);
                })
                .catch(() => {});
                return;
            }

            // ===== SHARE (copie lien + anti autoclicker) =====
            const shareBtn = e.target.closest('.btn-share');
            if (shareBtn) {
                const id = shareBtn.dataset.id;
                const url = shareBtn.dataset.url;

                if (url && navigator.clipboard) {
                    navigator.clipboard.writeText(url).catch(() => {});
                }

                fetch(`/resource/${id}/share`, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (!data) return;
                        const countEl = shareBtn.querySelector('.share-count');
                        if (countEl) countEl.innerText = data.shares;

                        shareBtn.classList.add('btn-secondary');
                        setTimeout(() => shareBtn.classList.remove('btn-secondary'), 400);
                    })
                    .catch(() => {});
                return;
            }

            // ===== FAVORITE (persistant DB) =====
            const favBtn = e.target.closest('.btn-favorite');
            if (favBtn) {
                const id = favBtn.dataset.id;

                fetch(`/resource/${id}/favorite`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    if (!data || data.error) return;

                    if (data.favorited) {
                        favBtn.classList.remove('btn-outline-warning');
                        favBtn.classList.add('btn-warning');
                    } else {
                        favBtn.classList.remove('btn-warning');
                        favBtn.classList.add('btn-outline-warning');
                    }
                })
                .catch(() => {});
                return;
            }

        });
        </script>
    {% endblock %}
</body>
</html>