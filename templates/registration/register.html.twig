{% extends 'base.html.twig' %}

{% block title %}
    Créer un compte | {{ parent() }}
{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <style>
        .password-strength {
            margin-top: 0.85rem;
        }

        .password-strength__bar {
            width: 100%;
            height: 10px;
            border-radius: 999px;
            background: #e9edf5;
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, 0.08);
        }

        .password-strength__fill {
            height: 100%;
            width: 0;
            border-radius: 999px;
            transition: width 0.25s ease, background-color 0.25s ease;
            background: #dc3545;
        }

        .password-strength__meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 0.55rem;
            font-size: 0.92rem;
        }

        .password-strength__label {
            font-weight: 600;
        }

        .password-hints {
            list-style: none;
            padding-left: 0;
            margin: 0.9rem 0 0;
            display: grid;
            gap: 0.45rem;
        }

        .password-hints li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            color: #6c757d;
            font-size: 0.93rem;
        }

        .password-hints li i {
            width: 16px;
            text-align: center;
            color: #adb5bd;
            transition: color 0.2s ease;
        }

        .password-hints li.is-valid {
            color: #198754;
        }

        .password-hints li.is-valid i {
            color: #198754;
        }

        .password-hints li.is-invalid {
            color: #dc3545;
        }

        .password-hints li.is-invalid i {
            color: #dc3545;
        }

        .register-consent {
            line-height: 1.55;
        }
    </style>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <div class="mb-2">
                                <i class="fa-solid fa-user-plus fa-xl text-primary"></i>
                            </div>
                            <h1 class="h4 mb-1 fw-semibold">Créer un compte</h1>
                            <p class="text-muted mb-0">Renseignez vos informations pour vous inscrire</p>
                        </div>

                        {{ form_errors(registrationForm) }}

                        {{ form_start(registrationForm, {'attr': {'class': 'needs-validation'}}) }}

                            <div class="mb-3">
                                <label class="form-label" for="{{ registrationForm.email.vars.id }}">
                                    <i class="fa-solid fa-envelope me-2 text-muted"></i>Email
                                </label>
                                {{ form_widget(registrationForm.email, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'ex: nom@domaine.com'
                                    }
                                }) }}
                                <div class="form-text">Nous ne partagerons jamais votre email.</div>
                                {{ form_errors(registrationForm.email) }}
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="{{ registrationForm.username.vars.id }}">
                                    <i class="fa-solid fa-at me-2 text-muted"></i>Nom d'utilisateur
                                </label>
                                {{ form_widget(registrationForm.username, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'ex: squeezie'
                                    }
                                }) }}
                                {{ form_errors(registrationForm.username) }}
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label" for="{{ registrationForm.firstName.vars.id }}">
                                            <i class="fa-solid fa-id-card me-2 text-muted"></i>Prénom
                                        </label>
                                        {{ form_widget(registrationForm.firstName, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Votre prénom'
                                            }
                                        }) }}
                                        {{ form_errors(registrationForm.firstName) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label" for="{{ registrationForm.lastName.vars.id }}">
                                            <i class="fa-solid fa-id-card-clip me-2 text-muted"></i>Nom
                                        </label>
                                        {{ form_widget(registrationForm.lastName, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Votre nom'
                                            }
                                        }) }}
                                        {{ form_errors(registrationForm.lastName) }}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="{{ registrationForm.plainPassword.vars.id }}">
                                    <i class="fa-solid fa-lock me-2 text-muted"></i>Mot de passe
                                </label>
                                {{ form_widget(registrationForm.plainPassword, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': '••••••••',
                                        'data-password-input': 'true'
                                    }
                                }) }}

                                <div class="password-strength">
                                    <div class="password-strength__bar">
                                        <div class="password-strength__fill" id="passwordStrengthFill"></div>
                                    </div>

                                    <div class="password-strength__meta">
                                        <span class="text-muted">Niveau de sécurité</span>
                                        <span class="password-strength__label" id="passwordStrengthLabel">Très faible</span>
                                    </div>

                                    <ul class="password-hints">
                                        <li id="rule-length">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>Au moins 8 caractères</span>
                                        </li>
                                        <li id="rule-lower">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>Au moins une minuscule</span>
                                        </li>
                                        <li id="rule-upper">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>Au moins une majuscule</span>
                                        </li>
                                        <li id="rule-number">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>Au moins un chiffre</span>
                                        </li>
                                        <li id="rule-special">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>Au moins un caractère spécial</span>
                                        </li>
                                    </ul>
                                </div>

                                {{ form_errors(registrationForm.plainPassword) }}
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                                    <label class="form-check-label register-consent" for="{{ registrationForm.agreeTerms.vars.id }}">
                                        J'accepte les conditions d'utilisation et la politique de confidentialité.
                                    </label>
                                </div>
                                {{ form_errors(registrationForm.agreeTerms) }}
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fa-solid fa-check me-2"></i>Créer mon compte
                            </button>

                            <div class="text-center mt-4">
                                <p class="mb-0 text-muted">
                                    Vous avez déjà un compte ?
                                    <a class="text-decoration-none fw-semibold" href="{{ path('app_login') }}">
                                        Se connecter
                                    </a>
                                </p>
                            </div>

                        {{ form_end(registrationForm) }}

                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordInput = document.querySelector('[data-password-input="true"]');
            if (!passwordInput) return;

            const strengthFill = document.getElementById('passwordStrengthFill');
            const strengthLabel = document.getElementById('passwordStrengthLabel');

            const rules = {
                length: document.getElementById('rule-length'),
                lower: document.getElementById('rule-lower'),
                upper: document.getElementById('rule-upper'),
                number: document.getElementById('rule-number'),
                special: document.getElementById('rule-special')
            };

            function setRuleState(element, isValid, hasValue) {
                if (!element) return;

                element.classList.remove('is-valid', 'is-invalid');

                const icon = element.querySelector('i');
                if (!icon) return;

                if (!hasValue) {
                    icon.className = 'fa-solid fa-circle';
                    return;
                }

                if (isValid) {
                    element.classList.add('is-valid');
                    icon.className = 'fa-solid fa-check-circle';
                } else {
                    element.classList.add('is-invalid');
                    icon.className = 'fa-solid fa-circle-xmark';
                }
            }

            function updateStrength() {
                const value = passwordInput.value;

                const checks = {
                    length: value.length >= 8,
                    lower: /[a-z]/.test(value),
                    upper: /[A-Z]/.test(value),
                    number: /\d/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                const score = Object.values(checks).filter(Boolean).length;
                const hasValue = value.length > 0;

                setRuleState(rules.length, checks.length, hasValue);
                setRuleState(rules.lower, checks.lower, hasValue);
                setRuleState(rules.upper, checks.upper, hasValue);
                setRuleState(rules.number, checks.number, hasValue);
                setRuleState(rules.special, checks.special, hasValue);

                let width = 0;
                let color = '#dc3545';
                let label = 'Très faible';

                if (!hasValue) {
                    width = 0;
                    color = '#dc3545';
                    label = 'Très faible';
                } else if (score <= 2) {
                    width = 25;
                    color = '#dc3545';
                    label = 'Faible';
                } else if (score === 3) {
                    width = 50;
                    color = '#fd7e14';
                    label = 'Moyen';
                } else if (score === 4) {
                    width = 75;
                    color = '#20c997';
                    label = 'Bon';
                } else {
                    width = 100;
                    color = '#198754';
                    label = 'Fort';
                }

                if (strengthFill) {
                    strengthFill.style.width = width + '%';
                    strengthFill.style.backgroundColor = color;
                }

                if (strengthLabel) {
                    strengthLabel.textContent = label;
                    strengthLabel.style.color = color;
                }
            }

            passwordInput.addEventListener('input', updateStrength);
            updateStrength();
        });
    </script>
{% endblock %}