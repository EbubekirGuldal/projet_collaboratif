{% extends 'base.html.twig' %}

{% block title %}
    Mes ressources sauvegard&eacute;es |
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container py-4 py-lg-5 feed-page">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="feed-shell">
            <div class="feed-main">
                <section class="feed-hero card border-0 shadow-sm">
                    <div class="card-body p-4 p-lg-5">
                        <div class="feed-hero-row">
                            <div class="feed-hero-copy">
                                <span class="feed-eyebrow">Mon espace</span>
                                <h1 class="feed-title mb-2">Mes ressources sauvegard&eacute;es</h1>
                                <p class="feed-subtitle mb-0">
                                    Retrouvez en un coup d&apos;oeil les ressources que vous avez mises de c&ocirc;t&eacute;.
                                </p>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-dark" href="{{ path('app_home') }}">
                                    <i class="fa-solid fa-house me-2"></i>
                                    Retour au fil
                                </a>
                                <a class="btn btn-outline-dark" href="{{ path('app_profile') }}">
                                    <i class="fa-regular fa-user me-2"></i>
                                    Retour au profil
                                </a>
                            </div>
                        </div>

                        <div class="feed-search-state">
                            <span class="feed-search-pill">
                                <i class="fa-regular fa-bookmark"></i>
                                {{ savedCount }} ressource{{ savedCount > 1 ? 's' : '' }} affich&eacute;e{{ savedCount > 1 ? 's' : '' }}
                            </span>
                            {% if q %}
                                <span class="feed-search-pill">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                    Filtre : "{{ q }}"
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </section>

                <section class="card border-0 shadow-sm mt-4">
                    <div class="card-body p-4">
                        <div class="feed-hero-row align-items-lg-center">
                            <form class="nav-search d-flex flex-grow-1" method="get" action="{{ path('app_profile_saved_resources') }}">
                                <input type="hidden" name="sort" value="{{ sort }}">
                                <div class="input-group nav-search__group w-100 app-navbar__search-group">
                                    <span class="input-group-text nav-search__icon">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                    </span>
                                    <input
                                        class="form-control nav-search__input app-navbar__search-input"
                                        type="search"
                                        name="q"
                                        value="{{ q }}"
                                        placeholder="Rechercher dans mes sauvegardes..."
                                        aria-label="Rechercher dans mes sauvegardes"
                                    >
                                    <button class="btn btn-primary nav-search__btn d-none d-md-inline-flex app-navbar__search-btn" type="submit">
                                        Rechercher
                                    </button>
                                </div>
                            </form>

                            <div class="feed-sort" role="group" aria-label="Trier mes sauvegardes">
                                <a class="feed-sort__btn {{ sort == 'new' ? 'is-active' : '' }}" href="{{ path('app_profile_saved_resources', { q: q, sort: 'new' }) }}">
                                    <i class="fa-regular fa-clock"></i>
                                    <span>R&eacute;centes</span>
                                </a>
                                <a class="feed-sort__btn {{ sort == 'top' ? 'is-active' : '' }}" href="{{ path('app_profile_saved_resources', { q: q, sort: 'top' }) }}">
                                    <i class="fa-solid fa-arrow-trend-up"></i>
                                    <span>Populaires</span>
                                </a>
                                <a class="feed-sort__btn {{ sort == 'title' ? 'is-active' : '' }}" href="{{ path('app_profile_saved_resources', { q: q, sort: 'title' }) }}">
                                    <i class="fa-solid fa-arrow-down-a-z"></i>
                                    <span>Titre</span>
                                </a>
                            </div>
                        </div>

                        {% if q %}
                            <div class="feed-search-state mt-3">
                                <a class="feed-search-reset" href="{{ path('app_profile_saved_resources', { sort: sort }) }}">Effacer la recherche</a>
                            </div>
                        {% endif %}
                    </div>
                </section>

                <div class="feed-list mt-4">
                    {% if savedItems is empty %}
                        <section class="card border-0 shadow-sm feed-empty-state">
                            <div class="card-body p-4 p-lg-5">
                                <div class="feed-empty-icon">
                                    <i class="fa-regular fa-bookmark"></i>
                                </div>
                                <h2 class="h5 mt-3 mb-2">{{ totalSavedCount > 0 ? 'Aucun r&eacute;sultat pour cette recherche' : 'Aucune ressource sauvegard&eacute;e' }}</h2>
                                <p class="text-body-secondary mb-4">
                                    {{ totalSavedCount > 0 ? 'Essayez un autre mot-cl&eacute; ou changez le tri pour retrouver vos ressources.' : 'Sauvegardez des ressources depuis le fil pour les retrouver rapidement ici.' }}
                                </p>
                                <a href="{{ path('app_home') }}" class="btn btn-dark">
                                    Explorer le fil d&apos;actualit&eacute;
                                </a>
                                {% if totalSavedCount > 0 %}
                                    <a href="{{ path('app_profile_saved_resources') }}" class="btn btn-outline-dark ms-2">
                                        Voir toutes mes sauvegardes
                                    </a>
                                {% endif %}
                            </div>
                        </section>
                    {% endif %}

                    {% for item in savedItems %}
                        {% include 'resource/_card.html.twig' with {
                            resource: item.resource,
                            commentsCount: item.commentsCount,
                            isFavorite: true
                        } only %}
                    {% endfor %}
                </div>
            </div>

            <aside class="feed-sidebar">
                <div class="feed-sidebar__inner">
                    <section class="card border-0 shadow-sm feed-side-card">
                        <div class="card-body p-4">
                            <div class="feed-side-head">
                                <span class="feed-side-icon">
                                    <i class="fa-solid fa-circle-info"></i>
                                </span>
                                <div>
                                    <h2 class="h6 mb-1">Comment &ccedil;a marche</h2>
                                    <p class="feed-side-subtitle mb-0">Organisation personnelle</p>
                                </div>
                            </div>

                            <p class="feed-side-copy mb-0">
                                Utilisez le bouton bookmark sur le fil pour conserver les ressources utiles et y revenir plus tard.
                            </p>
                            <p class="feed-side-note mb-0 mt-3">
                                Total actuel : {{ totalSavedCount }} ressource{{ totalSavedCount > 1 ? 's' : '' }}.
                            </p>
                        </div>
                    </section>

                    <section class="card border-0 shadow-sm feed-side-card">
                        <div class="card-body p-4">
                            <div class="feed-side-head">
                                <span class="feed-side-icon">
                                    <i class="fa-solid fa-bolt"></i>
                                </span>
                                <div>
                                    <h2 class="h6 mb-1">Actions rapides</h2>
                                    <p class="feed-side-subtitle mb-0">Navigation</p>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-3">
                                <a class="btn btn-dark" href="{{ path('app_home') }}">
                                    <i class="fa-solid fa-compass me-2"></i>
                                    Explorer de nouvelles ressources
                                </a>
                                <a class="btn btn-outline-dark" href="{{ path('app_profile') }}">
                                    <i class="fa-regular fa-address-card me-2"></i>
                                    Voir mon profil
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </aside>
        </div>
    </div>
{% endblock %}
