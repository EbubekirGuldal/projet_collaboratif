<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport statistiques admin</title>
    <style>
        :root {
            color-scheme: light;
            --page-bg: #eef3fb;
            --surface: #ffffff;
            --surface-soft: #f7f9fd;
            --border: #d9e2f0;
            --text: #17253d;
            --muted: #60708a;
            --primary: #2b3b82;
            --success: #1f8f5f;
            --warning: #ce8124;
            --danger: #cd4f4f;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 32px;
            background: linear-gradient(180deg, #eef3fb 0%, #f8fbff 100%);
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .report-shell {
            max-width: 1100px;
            margin: 0 auto;
        }

        .report-header {
            padding: 28px 30px;
            border-radius: 24px;
            background: linear-gradient(135deg, #22346e 0%, #3652a4 100%);
            color: #ffffff;
            box-shadow: 0 18px 45px rgba(26, 39, 74, 0.18);
        }

        .report-kicker {
            margin: 0 0 10px;
            font-size: 13px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            opacity: 0.8;
        }

        .report-title {
            margin: 0;
            font-size: 34px;
            line-height: 1.1;
        }

        .report-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 18px;
        }

        .report-meta-chip {
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.18);
            font-size: 14px;
        }

        .section {
            margin-top: 22px;
            padding: 24px;
            border-radius: 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            box-shadow: 0 14px 35px rgba(26, 39, 74, 0.06);
        }

        .section-title {
            margin: 0 0 16px;
            font-size: 22px;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .metric-card {
            padding: 18px;
            border-radius: 16px;
            background: var(--surface-soft);
            border: 1px solid var(--border);
        }

        .metric-label {
            margin: 0;
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .metric-value {
            margin: 10px 0 0;
            font-size: 30px;
            font-weight: 700;
            color: var(--primary);
        }

        .insight-list {
            display: grid;
            gap: 12px;
        }

        .insight-item {
            padding: 16px 18px;
            border-radius: 16px;
            border-left: 6px solid var(--primary);
            background: var(--surface-soft);
            border-top: 1px solid var(--border);
            border-right: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .insight-item.positive {
            border-left-color: var(--success);
        }

        .insight-item.negative {
            border-left-color: var(--danger);
        }

        .insight-item.neutral {
            border-left-color: #6f809f;
        }

        .insight-label {
            margin: 0 0 6px;
            font-size: 14px;
            color: var(--muted);
            font-weight: 600;
        }

        .insight-value {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
            border-radius: 14px;
        }

        thead th {
            background: #edf2fb;
            color: #223350;
            text-align: left;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        th,
        td {
            padding: 13px 14px;
            border-bottom: 1px solid var(--border);
        }

        tbody tr:nth-child(even) {
            background: #fbfcfe;
        }

        .text-right {
            text-align: right;
        }

        .note {
            margin: 0 0 14px;
            padding: 13px 15px;
            border-radius: 14px;
            color: #745705;
            background: #fff8de;
            border: 1px solid #f1dc96;
        }

        @media print {
            body {
                padding: 0;
                background: #ffffff;
            }

            .section,
            .report-header {
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <main class="report-shell">
        <section class="report-header">
            <p class="report-kicker">Dashboard administrateur</p>
            <h1 class="report-title">Rapport des statistiques</h1>
            <div class="report-meta">
                <span class="report-meta-chip">Periode: {{ stats.selectedPeriodLabel }}</span>
                <span class="report-meta-chip">Genere le: {{ generatedAt|date('d/m/Y H:i') }}</span>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">Indicateurs principaux</h2>
            <div class="metrics-grid">
                <article class="metric-card">
                    <p class="metric-label">Ressources</p>
                    <p class="metric-value">{{ stats.totalResources }}</p>
                </article>
                <article class="metric-card">
                    <p class="metric-label">Utilisateurs actifs</p>
                    <p class="metric-value">{{ stats.activeUsers }}</p>
                </article>
                <article class="metric-card">
                    <p class="metric-label">Commentaires</p>
                    <p class="metric-value">{{ stats.commentsCount }}</p>
                </article>
                <article class="metric-card">
                    <p class="metric-label">Ressources exploitees</p>
                    <p class="metric-value">{{ stats.exploitedResources }}</p>
                </article>
                <article class="metric-card">
                    <p class="metric-label">Favoris</p>
                    <p class="metric-value">{{ stats.favoritesCount }}</p>
                </article>
                <article class="metric-card">
                    <p class="metric-label">Partages</p>
                    <p class="metric-value">{{ stats.sharesCount }}</p>
                </article>
            </div>
            <div class="metric-card" style="margin-top: 14px;">
                <p class="metric-label">Taux d'exploitation</p>
                <p class="metric-value">{{ stats.exploitationRate }}%</p>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">Insights</h2>
            <div class="insight-list">
                {% for insight in stats.quickInsights %}
                    <article class="insight-item {{ insight.tone }}">
                        <p class="insight-label">{{ insight.label }}</p>
                        <p class="insight-value">{{ insight.value }}</p>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">
                {{ stats.categoryDistributionSource == 'category' ? 'Repartition par categorie' : 'Repartition par statut' }}
            </h2>
            {% if stats.categoryDistributionSource == 'resource_status' %}
                <p class="note">
                    Affichage provisoire base sur le champ <code>resourceStatus</code>. La ressource n'etait pas encore reliee a une categorie metier.
                </p>
            {% endif %}

            <table>
                <thead>
                    <tr>
                        <th>Categorie</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Pourcentage</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in stats.categoryDistribution %}
                        {% set percent = stats.distributionTotal > 0 ? ((item.total / stats.distributionTotal) * 100) : 0 %}
                        <tr>
                            <td>{{ item.label }}</td>
                            <td class="text-right">{{ item.total }}</td>
                            <td class="text-right">{{ percent|number_format(1, ',', ' ') }}%</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">Aucune donnee disponible.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section class="section">
            <h2 class="section-title">Top ressources</h2>
            <table>
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th class="text-right">Partages</th>
                        <th class="text-right">Commentaires</th>
                        <th class="text-right">Score</th>
                    </tr>
                </thead>
                <tbody>
                    {% for resource in stats.topResources %}
                        <tr>
                            <td>{{ resource.title }}</td>
                            <td class="text-right">{{ resource.shares }}</td>
                            <td class="text-right">{{ resource.comments }}</td>
                            <td class="text-right">{{ resource.engagementScore }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">Aucune ressource avec engagement pour cette periode.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
</body>
</html>
