<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top app-navbar">
	<div class="container">

		<a class="navbar-brand fw-semibold d-flex align-items-center gap-2 app-navbar__brand" href="{{ path('app_home') }}">
			<span class="app-navbar__brand-mark">
				<i class="fa-solid fa-hand-holding-heart"></i>
			</span>
			<span>Ressources relationnelles</span>
		</a>

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse" id="mainNavbar">
			<form class="nav-search d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0 app-navbar__search" role="search" method="get" action="{{ path('app_home') }}">
				<div class="input-group nav-search__group w-100 app-navbar__search-group">
					<span class="input-group-text nav-search__icon">
						<i class="fa-solid fa-magnifying-glass"></i>
					</span>

					<input
						class="form-control nav-search__input app-navbar__search-input"
						type="search"
						name="q"
						value="{{ app.request.query.get('q') }}"
						placeholder="Rechercher une ressource..."
						aria-label="Rechercher"
					>

					<button class="btn btn-primary nav-search__btn d-none d-lg-inline-flex app-navbar__search-btn" type="submit">
						Rechercher
					</button>
				</div>
			</form>

			<div class="d-flex align-items-center gap-2 ms-lg-2 app-navbar__actions flex-wrap">
				{% if app.user %}
					<a class="btn btn-dark app-navbar__action" href="{{ path('resource_new') }}">
						<i class="fa-solid fa-plus"></i>
						Proposer
					</a>

					<a class="btn btn-outline-dark app-navbar__action" href="{{ path('app_profile_saved') }}">
						<i class="fa-regular fa-bookmark"></i>
