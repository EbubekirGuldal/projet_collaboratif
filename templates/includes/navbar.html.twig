					<a href="{{ path('admin') }}" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 px-3 rounded-pill shadow-sm app-navbar__admin">
						<i class="fa-solid fa-shield-halved"></i>
						<span>Admin</span>
