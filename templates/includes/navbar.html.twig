					</a>

					<a class="btn btn-outline-dark app-navbar__action app-navbar__action--profile" href="{{ path('app_profile') }}">
						<i class="fa-solid fa-user"></i>
						Profil
					</a>

					<a class="btn app-navbar__action app-navbar__action--ghost" href="{{ logout_path() }}">
						<i class="fa-solid fa-right-from-bracket"></i>
						Déconnexion
					</a>
				{% else %}
					<a class="btn btn-outline-dark app-navbar__action" href="{{ path('app_login') }}">
						<i class="fa-solid fa-right-to-bracket"></i>
