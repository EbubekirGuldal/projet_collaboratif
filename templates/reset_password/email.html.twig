<div style="margin:0; padding:0; background:#f6f7fb;">
	<div style="max-width:640px; margin:0 auto; padding:32px 16px;">
		<div
			style="background:#ffffff; border:1px solid #e9ecf2; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(15, 23, 42, 0.06);">

			{# Header #}
			<div style="padding:28px 28px 14px 28px; border-bottom:1px solid #eef1f6;">
				<div style="font-family:Arial, sans-serif; font-size:14px; color:#64748b; letter-spacing:0.2px;">
					Réinitialisation du mot de passe
				</div>
				<div style="font-family:Arial, sans-serif; font-size:22px; font-weight:700; color:#0f172a; margin-top:6px; line-height:1.25;">
					Créez un nouveau mot de passe
				</div>
			</div>

			{# Body #}
			<div style="padding:22px 28px 10px 28px; font-family:Arial, sans-serif; color:#0f172a;">
				<p style="margin:0 0 12px 0; font-size:14px; line-height:1.6; color:#334155;">
					Bonjour,
				</p>

				<p style="margin:0 0 18px 0; font-size:14px; line-height:1.6; color:#334155;">
					Vous avez demandé la réinitialisation de votre mot de passe. Cliquez sur le bouton ci-dessous pour en définir un nouveau.
				</p>

				{# Button #}
				<div style="text-align:left; margin:18px 0 18px 0;">
					<a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="display:inline-block; padding:12px 18px; background:#0f172a; color:#ffffff; text-decoration:none; border-radius:12px; font-weight:700; font-size:14px;">
						Réinitialiser mon mot de passe
					</a>
				</div>

				<p style="margin:0 0 14px 0; font-size:12px; line-height:1.6; color:#64748b;">
					Ce lien expirera dans
					<strong style="color:#334155;">{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
				</p>

				<div style="margin-top:14px; padding:12px 14px; background:#f8fafc; border:1px solid #e9ecf2; border-radius:12px;">
					<div style="font-size:12px; color:#64748b; line-height:1.5;">
						Si le bouton ne fonctionne pas, copiez/collez ce lien dans votre navigateur :
					</div>
					<div style="font-size:12px; line-height:1.5; margin-top:6px; word-break:break-all;">
						<a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="color:#2563eb; text-decoration:none;">
							{{ url('app_reset_password', {token: resetToken.token}) }}
						</a>
					</div>
				</div>

				<p style="margin:18px 0 0 0; font-size:12px; line-height:1.6; color:#64748b;">
					Si vous n’êtes pas à l’origine de cette demande, vous pouvez ignorer ce message en toute sécurité.
				</p>
			</div>

			{# Footer #}
			<div style="padding:18px 28px; border-top:1px solid #eef1f6; background:#ffffff;">
				<div style="font-family:Arial, sans-serif; font-size:12px; color:#94a3b8; line-height:1.6;">
					—<br>
					<strong style="color:#64748b;">{{ app_name|default('Ressources Relationnelles') }}</strong><br>
					<span style="color:#94a3b8;">Message automatique, merci de ne pas répondre.</span>
				</div>
			</div>

		</div>

		<div style="text-align:center; margin-top:14px; font-family:Arial, sans-serif; font-size:12px; color:#94a3b8;">
			©
			{{ "now"|date("Y") }}
			{{ app_name|default('Ressources Relationnelles') }}
		</div>
	</div>
</div>
