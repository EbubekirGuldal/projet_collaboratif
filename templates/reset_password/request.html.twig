{% extends 'base.html.twig' %}

{% block title %}
	Mot de passe oublié |
	{{ parent() }}
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div class="row justify-content-center">
			<div
				class="col-12 col-sm-10 col-md-8 col-lg-5">

				{# Flash erreurs reset #}
				{% for flash_error in app.flashes('reset_password_error') %}
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<i class="fa-solid fa-triangle-exclamation me-2"></i>
						{{ flash_error }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
					</div>
				{% endfor %}

				<div class="card border-0 shadow-sm">
					<div class="card-body p-4 p-md-5">

						<div class="text-center mb-4">
							<div class="mb-2">
								<i class="fa-solid fa-key fa-xl text-primary"></i>
							</div>
							<h1 class="h4 mb-1 fw-semibold">Mot de passe oublié ?</h1>
							<p class="text-muted mb-0">
								Saisissez votre email et nous vous enverrons un lien de réinitialisation.
							</p>
						</div>

						{{ form_start(requestForm, {'attr': {'class': 'needs-validation'}}) }}

						<div
							class="mb-3">
							{# Email #}
							<label class="form-label" for="{{ requestForm.email.vars.id }}">
								<i class="fa-regular fa-envelope me-2 text-muted"></i>
								Adresse email
							</label>

							{{ form_widget(requestForm.email, {
                                'attr': {
                                    'class': 'form-control',
                                    'autocomplete': 'email'
                                }
                            }) }}

							{{ form_errors(requestForm.email) }}

							<div class="form-text">
								Si un compte correspond à cet email, vous recevrez un message avec un lien valable pendant une durée limitée.
							</div>
						</div>

						<button class="btn btn-primary btn-lg w-100" type="submit">
							<i class="fa-regular fa-paper-plane me-2"></i>
							Envoyer le lien de réinitialisation
						</button>

						<div class="text-center mt-4">
							<a class="text-decoration-none fw-semibold" href="{{ path('app_login') }}">
								<i class="fa-solid fa-arrow-left me-2"></i>
								Retour à la connexion
							</a>
						</div>

						{{ form_end(requestForm) }}

					</div>
				</div>

				<p class="text-center text-muted small mt-3 mb-0">
					©
					{{ "now"|date("Y") }}
					— Ressources Relationnelles
				</p>

			</div>
		</div>
	</div>
{% endblock %}
