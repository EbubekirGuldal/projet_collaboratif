{% extends 'base.html.twig' %}

{% block title %}
	Se connecter |
	{{ parent() }}
{% endblock %}

{% block body %}
	<div class="container py-5">

		<div class="row justify-content-center">
			<div class="col-12 col-sm-10 col-md-8 col-lg-5">
				<div class="card shadow-sm border-0">
					<div class="card-body p-4 p-md-5">

						{% for label, messages in app.flashes %}
							{% for message in messages %}
								<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
									{{ message }}
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
								</div>
							{% endfor %}
						{% endfor %}

						{# Titre #}
						<div class="text-center mb-4">
							<h1 class="h4 mb-1 fw-semibold">Connexion</h1>
							<p class="text-muted mb-0">Accédez à votre espace</p>
						</div>

						{# Erreur #}
						{% if error %}
							<div class="alert alert-danger d-flex align-items-center" role="alert">
								<i class="bi bi-exclamation-triangle-fill me-2"></i>
								<div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
							</div>
						{% endif %}

						{# Déjà connecté #}
						{% if app.user %}
							<div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
								<div>
									Connecté en tant que
									<strong>{{ app.user.userIdentifier }}</strong>
								</div>
								<a class="btn btn-sm btn-outline-primary" href="{{ logout_path() }}">Se déconnecter</a>
							</div>
						{% endif %}

						<form method="post" class="needs-validation" novalidate>
							<div class="mb-3">
								<label for="inputEmail" class="form-label">Email</label>
								<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control form-control-lg" autocomplete="email" required autofocus placeholder="ex: nom@domaine.com">
								<div class="invalid-feedback">
									Merci de renseigner un email valide.
								</div>
							</div>

							<div class="mb-2">
								<label for="inputPassword" class="form-label">Mot de passe</label>
								<input type="password" name="password" id="inputPassword" class="form-control form-control-lg" autocomplete="current-password" required placeholder="••••••••">
								<div class="invalid-feedback">
									Merci de renseigner votre mot de passe.
								</div>
							</div>

							<div class="d-flex justify-content-between align-items-center my-3">
								<div class="form-check">
									<input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
									<label class="form-check-label" for="rememberMe">
										Se souvenir de moi
									</label>
								</div>

								<a class="small text-decoration-none fw-semibold" href="{{ path('app_forgot_password_request') }}">
									Mot de passe oublié ?
								</a>
							</div>

							<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

							<button class="btn btn-primary btn-lg w-100" type="submit">
								Se connecter
							</button>

							<div class="text-center my-4">
								<div class="login-divider text-muted small">ou</div>
							</div>

							<p class="text-center mb-0">
								Pas de compte ?
								<a class="text-decoration-none fw-semibold" href="{{ path('app_register') }}">
									Créer un compte
								</a>
							</p>
						</form>

					</div>
				</div>

				<p class="text-center text-muted small mt-3 mb-0">
					©
					{{ "now"|date("Y") }}
					— Ressources Relationnelles
				</p>
			</div>
		</div>
	</div>
{% endblock %}
